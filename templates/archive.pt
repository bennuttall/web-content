<main metal:use-macro="layout">
  <div metal:fill-slot="head" tal:omit-tag="1">
    <meta name="description" content="Ben Nuttall's blog archive" />
    <meta property="og:url" content="${site.config.base_url}/${link}/" />
    <meta property="og:title" content="${title}" />
    <meta property="og:description" content="Ben Nuttall's blog archive" />
    <meta name="twitter:title" content="${title}" />
    <meta name="twitter:description" content="Ben Nuttall's blog archive" />
  </div>

  <div metal:fill-slot="title" tal:omit-tag="1">${title}</div>

  <main metal:fill-slot="content" class="site-main">
    <div class="container layout">
      <div class="reading">
        <h1 class="page-title">${title}</h1>
        <section class="archive-year" tal:repeat="(year, posts) site.archive.items()">
          <h2><a href="/blog/${year}/">${year}</a></h2>
          <ul>
            <li tal:repeat="post posts">
              <a href="/${post.link}/" tal:content="structure post.title"></a>
            </li>
          </ul>
        </section>
      </div>

      <aside class="side-col">
        <nav class="widget" aria-label="Archive">
          <h2 class="widget-title">Archive</h2>
          <ul class="widget-list">
            <li><a href="/blog/archive/">All posts</a></li>
            <li><a href="/blog/tags/">Tags</a></li>
            <li tal:repeat="(year, posts) site.archive.items()"><a href="/blog/${year}/">${year} (${len(posts)})</a></li>
          </ul>
        </nav>
      </aside>
    </div>
  </main>
</main>
