<main metal:use-macro="layout">
  <div metal:fill-slot="head" tal:omit-tag="1">
    <meta name="description" content="Ben Nuttall's blog" />
    <meta property="og:url" content="${site.config.base_url}/${link}/" />
    <meta property="og:title" content="Ben Nuttall's blog" />
    <meta property="og:description" content="Ben Nuttall's blog" />
    <meta name="twitter:title" content="Ben Nuttall's blog" />
    <meta name="twitter:description" content="Ben Nuttall's blog" />
  </div>

  <div metal:fill-slot="title" tal:omit-tag="1">Blog</div>

  <main metal:fill-slot="content" class="site-main">
    <div class="container layout">
      <div>
        <h1 class="page-title">Blog</h1>
        <div class="post-list">
          <article class="post-summary" tal:repeat="post site.posts[:10]">
            <time datetime="${post.published.isoformat(timespec='seconds')}" title="${post.published.isoformat(timespec='seconds')}">${post.published.strftime("%-d %B %Y")}</time>
            <h2><a href="/${post.link}/" tal:content="structure post.title"></a></h2>
            <p tal:content="structure post.excerpt"></p>
            <div class="tags">
              <a tal:repeat="tag post.tags" href="/blog/tags/${tag}/">${tag.replace("-", " ")}</a>
            </div>
          </article>
        </div>
        <p><a href="/blog/archive/">Browse the full archive &rarr;</a></p>
      </div>

      <aside class="side-col">
        <nav class="widget" aria-label="Archive">
          <h2 class="widget-title">Archive</h2>
          <ul class="widget-list">
            <li><a href="/blog/archive/">All posts</a></li>
            <li><a href="/blog/tags/">Tags</a></li>
            <li tal:repeat="(year, posts) site.archive.items()"><a href="/blog/${year}/">${year} (${len(posts)})</a></li>
          </ul>
        </nav>
      </aside>
    </div>
  </main>
</main>
