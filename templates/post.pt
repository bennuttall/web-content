<main metal:use-macro="layout">
  <div metal:fill-slot="head" tal:omit-tag="1">
    <meta name="description" content="${post.excerpt}" />
    <meta property="og:type" content="article" />
    <meta property="og:url" content="${site.config.base_url}/${post.link}/" />
    <meta property="og:title" content="${post.title}" />
    <meta property="og:description" content="${post.excerpt}" />
    <meta name="twitter:title" content="${post.title}" />
    <meta name="twitter:description" content="${post.excerpt}" />
    <meta tal:condition="post.og_image" property="og:image" content="${site.config.base_url}/${post.link}/${post.og_image}" />
    <meta tal:condition="post.og_image" name="twitter:image" content="${site.config.base_url}/${post.link}/${post.og_image}" />
  </div>

  <div metal:fill-slot="title" tal:omit-tag="1" tal:content="structure post.title"></div>

  <main metal:fill-slot="content" class="site-main">
    <div class="container layout">
      <article class="reading">
        <header class="post-header">
          <nav class="breadcrumb" aria-label="Breadcrumb">
            <a href="/blog/">Blog</a> /
            <a href="/blog/${post.published.year}/">${post.published.year}</a> /
            <a href="/blog/${post.published.strftime('%Y/%m')}/">${post.published.strftime("%B")}</a>
          </nav>
          <div class="post-meta">
            <span>Published <time datetime="${post.published.isoformat(timespec='seconds')}" title="${post.published.isoformat(timespec='seconds')}">${post.published.strftime("%-d %B %Y")}</time></span>
            <span tal:condition="post.modified_diff">Updated <time datetime="${post.modified.isoformat(timespec='seconds')}" title="${post.modified.isoformat(timespec='seconds')}">${post.modified.strftime("%-d %B %Y")}</time></span>
          </div>
          <h1 tal:content="structure post.title"></h1>
        </header>

        <div class="prose">
          <div tal:content="structure post.html"></div>
        </div>

        <div class="tags" tal:condition="post.tags">
          <span class="tags-label">Tags</span>
          <a tal:repeat="tag post.tags" href="/blog/tags/${tag}/">${tag.replace("-", " ")}</a>
        </div>

        <nav class="post-nav" tal:condition="prev_post or next_post" aria-label="Post navigation">
          <a tal:condition="prev_post" class="prev" href="/${prev_post.link}/" rel="prev">&larr; <span tal:content="structure prev_post.title"></span></a>
          <a tal:condition="next_post" class="next" href="/${next_post.link}/" rel="next"><span tal:content="structure next_post.title"></span> &rarr;</a>
        </nav>
      </article>

      <aside class="side-col">
        <nav class="widget" aria-label="Archive">
          <h2 class="widget-title">Archive</h2>
          <ul class="widget-list">
            <li><a href="/blog/archive/">All posts (${len(site.posts)})</a></li>
            <li><a href="/blog/tags/">Tags (${len(site.tags)})</a></li>
            <li tal:repeat="(year, posts) site.archive.items()"><a href="/blog/${year}/">${year} (${len(posts)})</a></li>
          </ul>
        </nav>
      </aside>
    </div>
  </main>
</main>
