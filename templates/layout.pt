<foo tal:omit-tag="1" metal:define-macro="layout"><!doctype html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <title>Ben Nuttall — <span metal:define-slot="title" /></title>

    <script>
      // Apply the saved theme before paint to avoid a flash of the wrong theme.
      (function () {
        try {
          var t = localStorage.getItem("theme");
          if (t === "light" || t === "dark") {
            document.documentElement.setAttribute("data-theme", t);
          }
        } catch (e) {}
      })();
    </script>

    <link rel="stylesheet" href="/styles.css" />
    <link rel="shortcut icon" href="/favicon.ico" type="image/x-icon" />
    <link rel="icon" href="/favicon.ico" type="image/x-icon" />
    <link rel="alternate" type="application/atom+xml" title="Ben Nuttall Atom Feed" href="/blog/atom.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Ben Nuttall" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@ben_nuttall" />
    <tal:block tal:condition="not (post or page) or ((post and not post.og_image) or (page and not page.og_image))">
      <meta property="og:image" content="${site.config.base_url}/finn.webp" />
      <meta name="twitter:image" content="${site.config.base_url}/finn.webp" />
    </tal:block>

    <meta metal:define-slot="head" />
  </head>

  <body>
    <header class="site-header">
      <div class="container">
        <a class="brand" href="/">
          <img src="/finn-75.webp" alt="" width="38" height="38" />
          <span>Ben Nuttall</span>
        </a>
        <div class="header-right">
          <nav class="nav" aria-label="Primary">
            <a href="/">Home</a>
            <a href="/blog/">Blog</a>
            <a href="/talks/">Talks</a>
            <a href="/projects/">Projects</a>
            <a href="/about/">About</a>
          </nav>
          <button class="theme-toggle" type="button" aria-label="Switch between light and dark theme" title="Switch theme">
            <svg class="icon-sun" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="4" />
              <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" />
            </svg>
            <svg class="icon-moon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
            </svg>
          </button>
        </div>
      </div>
    </header>

    <main metal:define-slot="content" class="site-main"></main>

    <footer class="site-footer">
      <div class="container">
        <div class="footer-grid">
          <div>
            <h4>Blog</h4>
            <ul>
              <li><a href="/blog/">Blog index</a></li>
              <li><a href="/blog/archive/">Archive</a></li>
              <li><a href="/blog/tags/">Tags</a></li>
              <li><a href="/images/">Images</a></li>
              <li><a href="/blog/atom.xml">Atom feed</a></li>
            </ul>
          </div>
          <div>
            <h4>Find me online</h4>
            <ul>
              <li><a rel="me" href="https://mastodon.social/@bennuttall">Mastodon</a></li>
              <li><a href="https://github.com/bennuttall">GitHub</a></li>
              <li><a href="https://www.linkedin.com/in/ben-td-nuttall">LinkedIn</a></li>
              <li><a href="https://bsky.app/profile/bennuttall.bsky.social">BlueSky</a></li>
              <li><a href="https://x.com/ben_nuttall">Twitter</a></li>
              <li><a href="https://www.flickr.com/photos/ben_nuttall">Flickr</a></li>
              <li><a href="https://www.youtube.com/@BenNuttall">YouTube</a></li>
            </ul>
          </div>
          <div>
            <h4>This site</h4>
            <p>
              Built with <a href="https://github.com/bennuttall/beemo">Beemo</a>.<br />
              Content on <a href="https://github.com/bennuttall/web-content">GitHub</a>.<br />
              Text licensed
              <a href="https://creativecommons.org/licenses/by-sa/4.0/">CC&nbsp;BY-SA&nbsp;4.0</a>.
            </p>
          </div>
        </div>
        <div class="footer-bottom">
          Copyright &copy; 2006&ndash;${site.now.year} Ben Nuttall
        </div>
      </div>
    </footer>

    <script>
      (function () {
        var btn = document.querySelector(".theme-toggle");
        if (!btn) return;
        btn.addEventListener("click", function () {
          var root = document.documentElement;
          var system = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
          var effective = root.getAttribute("data-theme") || system;
          var next = effective === "dark" ? "light" : "dark";
          if (next === system) {
            // Back in step with the OS: drop the override so it follows the system.
            root.removeAttribute("data-theme");
          } else {
            root.setAttribute("data-theme", next);
          }
          try {
            if (next === system) {
              localStorage.removeItem("theme");
            } else {
              localStorage.setItem("theme", next);
            }
          } catch (e) {}
        });
      })();
    </script>
  </body>
</html>
</foo>
